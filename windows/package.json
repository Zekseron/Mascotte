{
  "name": "mascotte-windows",
  "version": "0.8.2",
  "private": true,
  "description": "Mascotte desktop per Windows — anteprima",
  "author": "Zekseron",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "resources": "node scripts/resources.cjs",
    "start": "npm run resources && electron .",
    "test": "node --test test/*.test.cjs",
    "test:codex-policy": "node test/codex-policy.cjs",
    "build:win:package": "npm run resources && electron-builder --win zip --x64",
    "build:mac": "npm run resources && node scripts/build-mac.cjs",
    "install:mac": "node scripts/install-mac.cjs",
    "build:win": "npm run resources && electron-builder --win zip nsis --x64 && node scripts/copy-root-build.cjs",
    "update:win": "node scripts/install-update.cjs"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "copyright": "Copyright © 2026 Zekseron. Tutti i diritti riservati.",
    "appId": "local.mascotte.windows",
    "productName": "Mascotte",
    "asar": true,
    "extraResources": [
      { "from": "scripts/install-update.cjs", "to": "mascotte-updater.cjs" }
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "resources/**",
      "package.json",
      "!resources/mac/**"
    ],
    "win": {
      "target": "zip",
      "icon": "resources/app-icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [{ "target": "zip", "arch": "arm64" }, { "target": "dir", "arch": "arm64" }],
      "category": "public.app-category.utilities",
      "identity": "-",
      "notarize": false,
      "hardenedRuntime": false,
      "artifactName": "Mascotte-Mac-${version}-${arch}.${ext}",
      "extendInfo": { "LSUIElement": true },
      "extraResources": [{ "from": "resources/mac/mascotte-window-helper", "to": "mascotte-window-helper" }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mascotte",
      "uninstallDisplayName": "Mascotte",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Mascotte-Setup-${version}-${arch}.${ext}"
    },
    "artifactName": "Mascotte-Windows-${version}-${arch}.${ext}"
  }
}
